# ==========================================
# Void Wiki - Environment Configuration
# ==========================================

# PostgreSQL Database Configuration
DB_USER=wikijs
DB_PASS=change_this_to_a_secure_password
DB_NAME=wiki

# Port & Binding
# 127.0.0.1 keeps it internal so only Nginx reverse proxy accesses it
WIKI_BIND_IP=0.0.0.0
WIKI_PORT=3005

# Site URL (used by Wiki.js for redirect and asset resolution)
# Testing domain: https://wiki.zorth.eu
# Production domain: https://void.tarragon.be
WIKI_URL=https://wiki.zorth.eu

# Clerk Authentication (Production)
# Auth Server: clerk.tarragon.be
CLERK_ISSUER_URL=https://clerk.tarragon.be
CLERK_CLIENT_ID=your_clerk_oauth_client_id_here
CLERK_CLIENT_SECRET=your_clerk_oauth_client_secret_here
